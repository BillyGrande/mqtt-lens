#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh source-path=SCRIPTDIR
. "$here/lib.sh"
require_denylist
zero="0000000000000000000000000000000000000000"
stdin_copy="$(mktemp)"
trap 'rm -f "$stdin_copy" "${export_file:-}"' EXIT
cat > "$stdin_copy"
fail=0
while read -r _ local_sha _ remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi
  for c in $(git rev-list "${range[@]}"); do
    git log -1 --format=%B "$c" | scan_stream "message of $c" || fail=1
    git show --no-color -U0 --format= "$c" | scan_diff "diff of $c" || fail=1
  done
done < "$stdin_copy"
root="$(git rev-parse --show-toplevel)"
if [ -d "$root/.beads" ] && command -v bd >/dev/null 2>&1; then
  export_file="$(mktemp)"
  if DO_NOT_TRACK=1 DOLT_DISABLE_EVENT_FLUSH=1 bd export -o "$export_file" >/dev/null 2>&1; then
    scan_stream "beads export" < "$export_file" || fail=1
  else
    echo "guardrail: bd export failed; cannot scan beads data. Failing closed." >&2
    fail=1
  fi
fi
[ "$fail" -eq 0 ] || exit 1
chain_beads pre-push "$@" < "$stdin_copy"
