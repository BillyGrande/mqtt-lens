#!/usr/bin/env bash
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh source-path=SCRIPTDIR
. "$here/lib.sh"
require_denylist
msg_file="${1:?commit message file missing}"
grep -v '^#' "$msg_file" | scan_stream "commit message" || exit 1
chain_beads commit-msg "$@"
